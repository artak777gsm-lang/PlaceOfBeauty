# Required — the app raises KeyError on startup without these two.
MONGO_URL=mongodb://localhost:27017
DB_NAME=placeofbeauty

# Comma-separated origins, or * to allow any.
CORS_ORIGINS=http://localhost:3000

# /admin login. CHANGE THESE — server.py falls back to a well-known default
# when they are unset.
ADMIN_USER=admin
ADMIN_PASS=

# Where uploads land, and the prefix they are served under.
UPLOAD_DIR=./uploads
UPLOAD_URL_PREFIX=/uploads
